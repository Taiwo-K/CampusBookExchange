# ============================================================
#  CampusBookExchange — environment variables
#
#  Copy this file to `.env` and fill in the real values:
#
#      cp .env.example .env
#
#  `.env` is in .gitignore and must never be committed.
#  If a real key is ever committed by accident, rotate it.
#  Deleting the commit is not enough — it stays in the history.
# ============================================================

# ---- Database -----------------------------------------------
# The connection string from the Neon dashboard.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ---- Flask --------------------------------------------------
# Signs the session cookie. Any long random string.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# The site's own address. Used to build verification links.
# In production this is the Render URL.
APP_BASE_URL=http://localhost:5000

# How long a login lasts without activity.
SESSION_TTL_HOURS=72

# TEMPORARY — delete once FR-3 login is merged.
# Set to a user id and every request is treated as that user, so you
# can build and test your feature before the login page exists.
# Only works with --debug on.
DEV_LOGIN_AS=1

# ---- Passwords ----------------------------------------------
# bcrypt cost factor. 12 is a reasonable default; higher is
# slower to hash and slower to attack.
BCRYPT_ROUNDS=12

# ---- Email (FR-2 verification, FR-13 watchlist alerts) ------
# API key from resend.com
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Leave this true while developing. Verification links print to
# your terminal instead of being sent. You will register dozens
# of test accounts and do not want them all in an inbox.
EMAIL_DEV_LOG_ONLY=true

# ---- Verification tokens (FR-2) -----------------------------
VERIFICATION_TOKEN_TTL_HOURS=24

# ---- ISBN lookup (FR-5) -------------------------------------
# Open Library needs no key. Here so the base URL is
# configurable if we swap providers later.
ISBN_API_BASE=https://openlibrary.org/api/books

# ---- Image upload (FR-5) ------------------------------------
# Local disk in development. Render's free tier does not keep
# files between restarts, so this needs a hosted store before
# the deployed version can hold photos.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_PHOTOS_PER_LISTING=5
